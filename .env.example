# API Exorcist — configuration reference.
# Copy to .env for local overrides. .env is gitignored; never commit real values.
#
# Every setting has a working default. The whole pipeline runs with none of
# these set, which is deliberate: the demo and the test suite must need no
# infrastructure.

# --- output ---------------------------------------------------------------
# Where scan results are written. Defaults to ./data relative to where you run
# `apix`, so results land next to you rather than inside the installed package.
# APIX_DATA_DIR=./data

# --- transport ------------------------------------------------------------
# local (default) = in-process bus, zero dependencies.
# kafka           = real broker; requires `pip install -e ".[stream]"`.
# APIX_BUS=local
# KAFKA_BOOTSTRAP=localhost:9092

# Elasticsearch is optional. When unreachable the pipeline writes JSON to disk
# instead, which is enough for the dashboard and the demo.
# ELASTIC_URL=http://localhost:9200

# --- detection thresholds -------------------------------------------------
# The traffic capture window, in days. A genuinely quarterly batch endpoint can
# look silent inside 30 days. Resist widening this to fix that: the ambiguity is
# meant to be resolved at the Safe Kill approval gate by a human, not hidden by
# a longer window.
# APIX_TRAFFIC_WINDOW_DAYS=30

# Calls/day below which an endpoint is not in *meaningful* use. Health checks,
# crawlers and stray probes keep dead endpoints technically "observed on the
# wire"; this threshold is what separates being called from being used.
# APIX_TRAFFIC_THRESHOLD=10

# --- live connector credentials (Phase 1, not yet implemented) ------------
# Read-only, least-privilege tokens. The Safe Kill controller uses a SEPARATE
# write-scoped credential so a compromise of the scanner cannot disable an
# endpoint.
# APIX_GITHUB_TOKEN=
# APIX_KONG_ADMIN_URL=
# APIX_KONG_ADMIN_TOKEN=
