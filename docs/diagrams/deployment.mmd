flowchart TB
    subgraph CUST["Customer environment — read-only access"]
        direction LR
        C1["Kong Admin API"]
        C2["GitHub org<br/>repos + Actions"]
        C3["Zeek sensor<br/>span port"]
        C4["CoreDNS / mesh"]
    end

    subgraph HOST["API Exorcist — self-hosted, single tenant"]
