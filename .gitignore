data/*.json
data/*.csv
!data/.gitkeep

# Trained model artefacts (tracked via the model registry, not git)
models/*.pkl
models/*.joblib

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
