# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
coverage.xml

# Local config and secrets — never commit these
.env
.env.*
!.env.example
*.pem
*.key
credentials.json

# Generated run artefacts (regenerate with `python pipeline.py`)
data/*.json
data/*.csv
!data/.gitkeep

# Trained model artefacts (tracked via the model registry, not git)
models/*.pkl
models/*.joblib

# Source papers — publisher-copyrighted. Kept locally for the team's reference,
# never committed: this repo may become public, and redistributing paywalled PDFs
# is not something a capstone should be doing. docs/papers/README.md tracks them.
docs/papers/*.pdf

# Generated Word documents. Regenerate with `python docs/build_docx.py`.
# Word files are opaque binaries that change wholesale on every rebuild, so
# committing them churns history for no benefit — the .md files are the source
# of truth and they diff properly.
docs/*.docx

# Repositories cloned for the demo. Fetched by demo/prepare.ps1, never committed.
demo/repos/

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
